# Copy to .env, or set the same variables in the environment instead.
# Required
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
GROQ_API_KEY=gsk_replace_with_key_from_console.groq.com

# Optional
# Groq models for answers in order of preference; the next one is used if a model is rate-limited or unavailable.
# The smallest of them picks documents by title.
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Public "Лісовий архів" folder on Google Drive.
DRIVE_FOLDER_ID=1b_hEjnkQfP8ZVP-OEbnYWqoGSFwXMAP3
# With a Google API key the bot reads exact modification times through the Drive API.
# Without it the public folder page is used.
GOOGLE_API_KEY=
ARCHIVE_SYNC_MINUTES=10
TZ_NAME=Europe/Kyiv
# The bot is for the forest's own animals: only those with a neighbour's invite link may use it.
# The link for the first animal is printed in the log at start (or: python -m bot.invite).
# false: the bot answers everyone.
INVITES_ONLY=true
# false: keep the bot's name, description and avatar as set in @BotFather.
SET_BOT_PROFILE=true
